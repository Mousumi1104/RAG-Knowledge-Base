# =============================================================================
# RAG Knowledge Base — DEPLOYMENT env (root, read by docker-compose.yml)
#
#   cp .env.example .env   # then fill in the values below
#
# This file is for `docker compose up`. It is SEPARATE from backend/.env
# (which targets the local-dev Postgres at 127.0.0.1:54329). Never commit a
# real `.env` with secrets — only this placeholder template is committed.
# =============================================================================

# --- Postgres ----------------------------------------------------------------
# Password for the `raguser` role in the pgvector container. CHANGE IN PROD.
POSTGRES_PASSWORD=ragpass

# --- LLM provider (Gemini) ---------------------------------------------------
# Provider policy: EMBEDDING_PROVIDER=local + LLM_PROVIDER=gemini are fixed in
# compose. Supply a Google AI Studio key here (free tier):
#   https://aistudio.google.com/apikey
# Leave EMPTY to commit; set a real value in your local `.env`. Never hardcode.
GEMINI_API_KEY=

# --- Admin auth (single hardcoded admin; no users table) ---------------------
# Dev defaults are INSECURE. CHANGE ADMIN_PASSWORD + JWT_SECRET_KEY IN PROD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=dev-secret-change-me-in-production

# --- Frontend ----------------------------------------------------------------
# Base URL the browser uses to reach the API. NEXT_PUBLIC_* is inlined at BUILD
# time (Next 14), so changing this requires `docker compose up --build`.
# For production set this to the PUBLIC API URL (e.g. https://api.example.com).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
