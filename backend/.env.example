# =============================================================================
# RAG Knowledge Base — Backend configuration example
# Copy to `.env` and adjust as needed. `.env` is gitignored.
#
# NOTE: With EMBEDDING_PROVIDER=local and LLM_PROVIDER=local (the defaults),
#       NO API keys are required. The app boots and tests pass with zero infra.
# =============================================================================

# --- Database ----------------------------------------------------------------
# PostgreSQL via psycopg v3. The local dev/test DB is managed by
# `scripts/pg_local.sh up` (userspace Postgres on 127.0.0.1:54329).
DATABASE_URL=postgresql+psycopg://raguser@127.0.0.1:54329/ragdb

# --- Vector store ------------------------------------------------------------
VECTOR_DB=pgvector

# --- Providers ---------------------------------------------------------------
# EMBEDDING_PROVIDER options: local | openai
# LLM_PROVIDER options:       local | openai | anthropic | gemini
# Selecting a cloud provider without its matching key falls back to local.
# NOTE: keep EMBEDDING_PROVIDER=local unless you re-index — stored vectors are
#       384-dim (local); OpenAI embeddings are 1536-dim and are incompatible.
EMBEDDING_PROVIDER=local
LLM_PROVIDER=local

# Secrets — leave blank to use the local providers (no keys needed).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini has a FREE tier — create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- RAG / embedding parameters ----------------------------------------------
EMBEDDING_DIM=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# --- Uploads -----------------------------------------------------------------
# 0 = unlimited (size guard disabled); any positive value caps upload size in MB.
MAX_UPLOAD_MB=0
# Comma-separated list is accepted (also a JSON array).
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# --- HTTP / CORS -------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# --- Auth (single admin; CHANGE IN PRODUCTION) -------------------------------
# Dev defaults below are insecure — override ADMIN_PASSWORD and JWT_SECRET_KEY
# with strong values before any non-local deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
